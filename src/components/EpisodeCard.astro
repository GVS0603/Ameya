---
import type { Episode } from '../data/episodes';
interface Props { ep: Episode; }
const { ep } = Astro.props;
const hasVideo = !!ep.video;
const stateLabel = ep.state === 'soon' ? 'En production' : 'Bientôt en ligne';
---
<article class="ep">
  {hasVideo ? (
    <div class="ep-media" data-video>
      <video preload="metadata" playsinline poster={ep.poster} src={ep.video}></video>
      <button class="ep-play" type="button" aria-label={`Lire — ${ep.title}`}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
      </button>
    </div>
  ) : (
    <div class="ep-media">
      <img src={ep.poster} alt="" loading="lazy" width="1080" height="1350" />
      <span class:list={['ep-state', ep.state]}>{stateLabel}</span>
    </div>
  )}
  <span class="ep-tag">Le geste — {ep.geste}</span>
  <h3 class="ep-title" set:html={ep.title}></h3>
</article>

<style>
  .ep{ display:flex; flex-direction:column; }
  .ep-media{
    position:relative; aspect-ratio:4/5; border-radius:5px; overflow:hidden;
    background:#0d0f0a; border:1px solid rgba(245,240,228,0.08);
  }
  .ep-media img, .ep-media video{
    width:100%; height:100%; object-fit:cover; transition:transform 1.3s cubic-bezier(.16,.7,.3,1);
  }
  .ep:hover .ep-media img{ transform:scale(1.045); }

  .ep-play{
    position:absolute; inset:0; margin:auto; width:58px; height:58px; border-radius:50%;
    display:flex; align-items:center; justify-content:center; cursor:pointer;
    color:var(--noir); background:rgba(245,240,228,0.92); border:none;
    backdrop-filter:blur(2px); transition:transform .35s, background .35s;
  }
  .ep-play:hover{ transform:scale(1.06); background:var(--flame); }
  .ep-media.playing .ep-play{ display:none; }
  .ep-media.playing video{ object-fit:contain; background:#000; }

  .ep-state{
    position:absolute; bottom:14px; left:14px;
    font-family:var(--mono); font-size:10px; letter-spacing:0.14em; text-transform:uppercase;
    padding:5px 11px; border-radius:2px; background:rgba(20,23,15,0.55); backdrop-filter:blur(2px);
  }
  .ep-state.live{ color:var(--cream); border:1px solid rgba(245,240,228,0.28); }
  .ep-state.soon{ color:var(--flame); border:1px solid rgba(232,199,122,0.42); }

  .ep-tag{
    font-family:var(--mono); font-size:10.5px; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--clay); margin:16px 0 6px; display:block;
  }
  .ep-title{ font-size:18px; font-weight:500; line-height:1.32; color:var(--cream); }
</style>
