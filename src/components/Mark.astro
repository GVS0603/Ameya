---
interface Props {
  size?: number;
  stroke?: string;
  bindu?: string;
  alive?: boolean;
}
const { size = 28, stroke = '#2B3226', bindu = '#A8734A', alive = false } = Astro.props;
---
<svg
  class:list={['ameya-mark', alive && 'flicker']}
  width={size} height={size} viewBox="0 0 200 200"
  aria-hidden="true"
  style="display:block;transform-origin:50% 90%;"
>
  <g transform="rotate(7 100 100)">
    <path fill="none" stroke={stroke} stroke-width="6" stroke-linejoin="round" stroke-linecap="round"
      d="M97,172 C 70,152 60,110 74,72 C 82,49 92,33 101,21 C 107,17 113,19 114,25 C 115,30 111,33 107,32 C 116,48 127,68 130,92 C 133,122 118,154 97,172 Z"/>
    <path fill="none" stroke={stroke} stroke-width="2.6" stroke-linecap="round" opacity="0.5"
      d="M99,186 C 95,160 93,110 94,66 C 95,50 97,38 100,29"/>
    <circle fill={bindu} cx="123" cy="36" r="8"/>
  </g>
</svg>

<style>
  .flicker{ animation: ameyaFlick 5.5s ease-in-out infinite; }
  @keyframes ameyaFlick{
    0%,100%{ transform: scaleY(1) skewX(0deg); }
    25%{ transform: scaleY(1.03) skewX(-1.2deg); }
    50%{ transform: scaleY(0.985) skewX(0.8deg); }
    75%{ transform: scaleY(1.02) skewX(-0.6deg); }
  }
  @media (prefers-reduced-motion:reduce){ .flicker{ animation:none; } }
</style>
